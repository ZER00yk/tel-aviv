DATABASE_URL=postgres://tellaviv:local-development-only@127.0.0.1:5432/tellaviv
REDIS_URL=redis://127.0.0.1:6379
APP_URL=http://localhost:3000
DEV_AUTH=true
DEV_ADMIN_USERNAME=developer
REALTIME_PORT=3001
NEXT_PUBLIC_REALTIME_URL=http://localhost:3001
STORAGE_LOCAL_PATH=/workspace/tell-aviv-data/uploads
# Production: NODE_ENV=production, DEV_AUTH=false, APP_URL=https://your-domain
# Native password hashing: Argon2id; never weaken below supported secure bounds.
AUTH_ARGON_MEMORY_KIB=65536
AUTH_ARGON_TIME_COST=3
AUTH_ARGON_PARALLELISM=1
# Optional: >=32 random bytes shared ONLY by the trusted proxy and server.
# The supplied Caddy recipe overwrites the source/proof headers. Never trust XFF.
AUTH_TRUSTED_PROXY_SECRET=
# Optional real email transport. Recovery codes work without email infrastructure.
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
# Optional separate 32-256 character random token for authenticated metrics scrapes.
# Never reuse the proxy proof, session credentials or account passwords.
METRICS_SCRAPE_TOKEN=
# Optional GIF search. Without both settings, the UI clearly reports unavailable.
GIF_PROVIDER=
GIPHY_API_KEY=
# Optional local maintenance. Production Compose provides a scheduled worker.
BACKUP_ENABLED=false
BACKUP_EVERY_HOURS=24
BACKUP_RETAIN_DAYS=14
BACKUP_MIN_KEEP=7
# Optional private raw 32-byte key file outside checkout/backups; mount separately in production.
BACKUP_ENCRYPTION_KEY_FILE=
# Optional separately administered mounted volume; encrypted envelopes only.
BACKUP_DESTINATION_PATH=
OPS_INTERVAL_SECONDS=60
