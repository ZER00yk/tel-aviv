{
  "name": "tell-aviv",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "pnpm dev:web",
    "dev:web": "node --env-file=.env node_modules/next/dist/bin/next dev apps/web --hostname 0.0.0.0 --port 3000",
    "dev:realtime": "tsx --env-file=.env apps/realtime/src/index.ts",
    "build": "pnpm --filter @tell-aviv/web build",
    "start": "pnpm --filter @tell-aviv/web start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "node --env-file=.env --import tsx node_modules/@playwright/test/cli.js test",
    "db:migrate": "tsx packages/database/src/migrate.ts",
    "format": "prettier --write apps packages games tests scripts docs/*.md",
    "ops:once": "tsx --env-file=.env scripts/ops-worker.ts --once --dry-run",
    "ops:worker": "tsx --env-file=.env scripts/ops-worker.ts --loop --apply",
    "storage:reconcile": "tsx --env-file=.env scripts/storage-reconcile.ts",
    "source:archive": "tsx scripts/source-archive.ts",
    "load:local": "tsx --env-file=.env scripts/mixed-load.ts"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "drizzle-orm": "^0.44.7",
    "ioredis": "^5.8.2",
    "katex": "^0.19.0",
    "lucide-react": "^0.468.0",
    "matter-js": "^0.20.0",
    "next": "^15.5.14",
    "phaser": "^3.90.0",
    "postgres": "^3.4.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.16",
    "@types/katex": "^0.16.8",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^24.7.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.38.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.16",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1",
    "vitest": "^3.2.4"
  },
  "type": "module"
}
